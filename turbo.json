{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["docs/WORK_QUEUE.json", "docs/MODULE_PROGRESS.json", "scripts/build-clinic.mjs", "scripts/build-snapshot.mjs"],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        ".build-status/latest.json",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_API_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "API_PORT",
        "ALLOWED_ORIGINS",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_API_URL",
        "ENABLE_INTAKE_COMMANDS"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck"
      ],
      "outputs": []
    }
  }
}
