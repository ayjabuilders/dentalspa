    "@supabase/supabase-js": "2.118.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "concurrently": "^9.2.0"
  }
}
