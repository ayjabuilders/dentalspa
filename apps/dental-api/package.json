{
  "name": "@dental/dental-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build && concurrently -k \"tsc --watch\" \"node --watch --env-file-if-exists=.env dist/main.js\"",
