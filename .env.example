# API: copy into apps/dental-api/.env. Use local development values only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# API server only; never copy this value into any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Preferred API-only credential; legacy SERVICE_ROLE_KEY remains supported.
SUPABASE_SECRET_KEY=
API_PORT=4300
ENABLE_INTAKE_COMMANDS=false
ENABLE_INQUIRY_CONTACT_OUTCOMES=false
ENABLE_LOCAL_CONFIGURED_BOOKING_CONFIRMATIONS=false
ENABLE_LOCAL_PATIENT_DOCUMENTS=false
LOCAL_PATIENT_DOCUMENTS_GATE_KEY=
ALLOWED_ORIGINS=http://localhost:4202,http://localhost:4204,http://localhost:4205
# For a phone/tablet demo, replace ALLOWED_ORIGINS with the exact host LAN origins
# (ports 4202, 4204 and 4205), and explicitly enable LAN API binding. Never use '*'.
# Next.js: copy these public values into each app's .env.local.
# A device on Wi-Fi cannot reach 127.0.0.1 on the host; use a reachable host LAN
# address for a local Supabase stack, or the hosted dev project's URL.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Keep blank to follow the browser's hostname on port 4300 (localhost or host LAN).
NEXT_PUBLIC_API_URL=
# Optional local verification of direct Storage transfers. Hosted HTTPS Supabase uses them automatically.
NEXT_PUBLIC_DOCUMENT_DIRECT_TRANSFER=false
# Clinic OS server only: set both for a hosted refresh-session endpoint.
# Pin the exact Supabase project and the deployment's HTTPS origin.
CLINIC_SESSION_PROJECT_REF=
CLINIC_APP_ORIGIN=
# No service-role credential is required or accepted by the frontend.

# Local synthetic manager-only draft quotes; no issuance or payments.
ENABLE_LOCAL_QUOTE_DRAFTS=false
LOCAL_QUOTE_DRAFT_GATE_KEY=
ENABLE_LOCAL_TEAM_ACCESS=false
LOCAL_TEAM_ACCESS_GATE_KEY=
# API server only: explicit hosted project and independently enabled finance modules.
# Match the private database activation key; these flags do not grant a user access.
HOSTED_SUPABASE_PROJECT_REF=
ENABLE_HOSTED_QUOTE_DRAFTS=false
ENABLE_HOSTED_INVOICES=false
ENABLE_HOSTED_PAYMENTS=false
ENABLE_HOSTED_INSTALLMENTS=false
HOSTED_FINANCE_GATE_KEY=
ENABLE_HOSTED_TEAM_ACCESS=false
HOSTED_TEAM_ACCESS_GATE_KEY=
ENABLE_HOSTED_PATIENT_DOCUMENTS=false
HOSTED_PATIENT_DOCUMENTS_GATE_KEY=
ENABLE_HOSTED_AGENDA_SETTINGS=false
HOSTED_AGENDA_SETTINGS_GATE_KEY=
ENABLE_HOSTED_CONFIGURED_BOOKING_CONFIRMATIONS=false
ENABLE_HOSTED_PUBLIC_AGENDA=false
HOSTED_PUBLIC_AGENDA_GATE_KEY=
HOSTED_PUBLIC_AGENDA_CLINIC_ID=
ENABLE_HOSTED_CONFIGURED_BOOKING_REQUESTS=false
# API server only: scheduled cleanup of expired temporary upload bytes (not patient records).
ENABLE_DOCUMENT_STAGING_CLEANUP=false
CRON_SECRET=
