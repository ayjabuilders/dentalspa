# API: copy into apps/dental-api/.env. Use local development values only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
API_PORT=4300
ENABLE_INTAKE_COMMANDS=false
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202
# Next.js: copy these public values into each app's .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4300
# No service-role credential is required or accepted by the frontend.
